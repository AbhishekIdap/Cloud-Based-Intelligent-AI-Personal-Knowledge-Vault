# --- Postgres ---
DATABASE_URL=postgres://postgres:Abhi%402005@localhost:5432/LifeGraph

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=30d

# --- Server ---
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- AI Assistant (optional) ---
# Priority order: Claude (if ANTHROPIC_API_KEY is set) -> Gemini (if
# GEMINI_API_KEY is set) -> built-in rule-based responder (always works,
# just not conversational, no actions). Leave both blank to use only the
# rule-based responder.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Free, non-expiring tier — get a key at https://aistudio.google.com/apikey
# The Gemini path can also take actions (star/hide/move/delete files,
# create reminders), not just answer questions — see
# backend/src/lib/geminiAssistantTools.js.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# --- S3-compatible object storage ---
# Works with AWS S3, Cloudflare R2, Backblaze B2, MinIO, etc.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=lifegraph-files
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Public base URL used to build storage_url / thumbnail_url values returned to the client.
# For MinIO/local dev this is usually S3_ENDPOINT + "/" + S3_BUCKET.
S3_PUBLIC_BASE_URL=http://localhost:9000/lifegraph-files
